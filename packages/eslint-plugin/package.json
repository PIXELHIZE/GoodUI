{
  "name": "@pixelhize/eslint-plugin-goodui",
  "version": "0.4.0",
  "type": "module",
  "description": "Deterministic project contracts for JavaScript, TypeScript, React, Vue, and Svelte.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": "^9.39.0 || ^10.0.0"
  },
  "dependencies": {
    "@pixelhize/goodui-core": "workspace:*",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "fast-glob": "^3.3.3",
    "svelte": "^5.57.3",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.0",
    "vue-eslint-parser": "^10.4.1",
    "@tailwindcss/node": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "@types/eslint": "^9.6.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "goodui",
    "ai",
    "policy",
    "react",
    "vue",
    "svelte"
  ]
}
