{
  "name": "goodui-workspace",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "test:consumer": "pnpm build && node scripts/consumer-smoke.mjs",
    "test:published": "node scripts/consumer-smoke.mjs --registry",
    "release:plan": "node scripts/release.mjs --dry-run",
    "release:publish": "node scripts/release.mjs --publish",
    "typecheck": "pnpm -r --sort typecheck",
    "check": "pnpm build && pnpm typecheck && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
